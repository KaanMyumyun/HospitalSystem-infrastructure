apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: github-actions-deployer
  namespace: "{{ k8s_namespace }}"
rules:
  # scripts/deploy-release.py reads and patches these two Deployments and
  # nothing else. policy/deploy-image-only.yaml.j2 limits the patch to images.
  - apiGroups:
      - apps
    resources:
      - deployments
    resourceNames:
      - "{{ backend_deployment }}"
      - "{{ frontend_deployment }}"
    verbs:
      - get
      - patch
  # The deploy's smoke test: GET requests to the two apps through the API
  # server, which names each proxy target "<service>:<port name>".
  - apiGroups:
      - ""
    resources:
      - services/proxy
    resourceNames:
      - "hospital-backend:http"
      - "hospital-frontend:http"
    verbs:
      - get
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: github-actions-deployer
  namespace: "{{ k8s_namespace }}"
subjects:
  - kind: Group
    name: "{{ github_actions_deploy_group }}"
    apiGroup: rbac.authorization.k8s.io
roleRef:
  kind: Role
  name: github-actions-deployer
  apiGroup: rbac.authorization.k8s.io
