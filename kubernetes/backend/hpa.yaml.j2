apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: hospital-backend
  namespace: "{{ k8s_namespace }}"
  labels:
    app.kubernetes.io/name: hospital-backend
    app.kubernetes.io/part-of: hospitalsystem
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: hospital-backend
  minReplicas: 1
  # No cluster autoscaler, so this is sized to the two t3.small nodes: two pods
  # of each app plus a rollout surge fit when memory requests equal limits.
  maxReplicas: 2
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
