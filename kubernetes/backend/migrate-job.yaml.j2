# Created by ansible/tasks/migrate.yml, not apply-kubernetes.yml: the bootstrap
# runs it before the backend starts, and an operator before deploying a release
# with new migrations (ansible/playbooks/migrate.yml). The backend image's
# --migrate command applies the migrations the image has and the database
# doesn't, then exits.
apiVersion: batch/v1
kind: Job
metadata:
  generateName: hospital-backend-migrate-
  namespace: "{{ k8s_namespace }}"
  labels:
    app.kubernetes.io/name: hospital-backend-migrate
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 300
  # tasks/migrate.yml deletes the Job once it has the log. This only cleans up
  # after a run that was interrupted.
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: hospital-backend-migrate
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      # The same restrictions as the backend Deployment.
      securityContext:
        runAsNonRoot: true
        runAsUser: 100
        runAsGroup: 101
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: migrate
          image: "{{ migration_image | default(backend_image) }}"
          imagePullPolicy: Always
          args: ["--migrate"]
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          # --migrate needs only the connection string.
          env:
            - name: ConnectionStrings__DefaultConnection
              valueFrom:
                secretKeyRef:
                  name: hospital-backend-secrets
                  key: ConnectionStrings__DefaultConnection
          # .NET keeps its diagnostic pipes in /tmp.
          volumeMounts:
            - name: tmp
              mountPath: /tmp
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
              ephemeral-storage: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
              ephemeral-storage: 256Mi
      volumes:
        - name: tmp
          emptyDir:
            sizeLimit: 64Mi
