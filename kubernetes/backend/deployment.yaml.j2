apiVersion: apps/v1
kind: Deployment
metadata:
  name: hospital-backend
  namespace: "{{ k8s_namespace }}"
  labels:
    app.kubernetes.io/name: hospital-backend
    app.kubernetes.io/part-of: hospitalsystem
spec:
  revisionHistoryLimit: 5
  minReadySeconds: 10
  progressDeadlineSeconds: 300
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app.kubernetes.io/name: hospital-backend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: hospital-backend
        app.kubernetes.io/part-of: hospitalsystem
    spec:
      terminationGracePeriodSeconds: 45
      # The app never calls the Kubernetes API.
      automountServiceAccountToken: false
      # One replica per node. A cordoned or unreachable node doesn't count, so
      # a drained pod can start again on the node that's left. The template
      # hash spreads each rollout's pods on their own.
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: DoNotSchedule
          nodeTaintsPolicy: Honor
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: hospital-backend
          matchLabelKeys:
            - pod-template-hash
      securityContext:
        runAsNonRoot: true
        # The image's USER is a name (appuser), which the kubelet can't check
        # against runAsNonRoot, so its UID and GID are set here.
        runAsUser: 100
        runAsGroup: 101
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: backend
          image: "{{ backend_image }}"
          imagePullPolicy: Always
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          # .NET keeps its diagnostic pipes in /tmp, and ASP.NET Core its
          # data-protection keys under $HOME/.aspnet.
          volumeMounts:
            - name: tmp
              mountPath: /tmp
            - name: aspnet
              mountPath: /home/appuser/.aspnet
          lifecycle:
            preStop:
              sleep:
                seconds: 15
          ports:
            - name: http
              containerPort: 8080
          envFrom:
            - configMapRef:
                name: hospital-backend-config
            - secretRef:
                name: hospital-backend-secrets
          # Check Neon before initial readiness, then stop probing the database
          # so the free compute can suspend when the application is idle.
          startupProbe:
            httpGet:
              path: /health/ready
              port: http
            periodSeconds: 10
            timeoutSeconds: 10
            failureThreshold: 12
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 15
            timeoutSeconds: 3
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 3
          resources:
            requests:
              cpu: 100m
              memory: 512Mi
              ephemeral-storage: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
              ephemeral-storage: 1Gi
      volumes:
        - name: tmp
          emptyDir:
            sizeLimit: 64Mi
        - name: aspnet
          emptyDir:
            sizeLimit: 8Mi
