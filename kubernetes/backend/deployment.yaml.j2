apiVersion: apps/v1
kind: Deployment
metadata:
  name: hospital-backend
  namespace: "{{ k8s_namespace }}"
  labels:
    app.kubernetes.io/name: hospital-backend
    app.kubernetes.io/part-of: hospitalsystem
spec:
  revisionHistoryLimit: 5
  minReadySeconds: 10
  progressDeadlineSeconds: 300
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app.kubernetes.io/name: hospital-backend
  template:
    metadata:
      labels:
        app.kubernetes.io/name: hospital-backend
        app.kubernetes.io/part-of: hospitalsystem
    spec:
      terminationGracePeriodSeconds: 45
      containers:
        - name: backend
          image: "{{ backend_image }}"
          imagePullPolicy: Always
          lifecycle:
            preStop:
              sleep:
                seconds: 15
          ports:
            - name: http
              containerPort: 8080
          envFrom:
            - configMapRef:
                name: hospital-backend-config
            - secretRef:
                name: hospital-backend-secrets
          # Check Neon before initial readiness, then stop probing the database
          # so the free compute can suspend when the application is idle.
          startupProbe:
            httpGet:
              path: /health/ready
              port: http
            periodSeconds: 10
            timeoutSeconds: 10
            failureThreshold: 12
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 15
            timeoutSeconds: 3
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 3
          resources:
            requests:
              cpu: 100m
              memory: 512Mi
              ephemeral-storage: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
              ephemeral-storage: 1Gi
