# Applied by ansible/playbooks/backend-secret.yml, not apply-kubernetes.yml,
# because the backend Secret has to exist before the Deployment starts pods.
#
# No pod runs as this service account. External Secrets requests a token for
# it and assumes the role in its annotation, which may only read the backend
# secret (terraform/secrets.tf).
apiVersion: v1
kind: ServiceAccount
metadata:
  name: backend-secrets-reader
  namespace: "{{ k8s_namespace }}"
  annotations:
    eks.amazonaws.com/role-arn: "{{ backend_secrets_reader_role_arn }}"
automountServiceAccountToken: false
---
apiVersion: external-secrets.io/v1
kind: SecretStore
metadata:
  name: aws-secrets-manager
  namespace: "{{ k8s_namespace }}"
spec:
  provider:
    aws:
      service: SecretsManager
      region: "{{ aws_region }}"
      auth:
        jwt:
          serviceAccountRef:
            name: backend-secrets-reader
---
# Each JSON key in the Secrets Manager secret becomes a key of the Kubernetes
# Secret, and envFrom turns each into an environment variable of the backend.
# Changing the Secret doesn't restart pods: backend-secret.yml does that.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: hospital-backend-secrets
  namespace: "{{ k8s_namespace }}"
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: SecretStore
    name: aws-secrets-manager
  target:
    name: hospital-backend-secrets
    creationPolicy: Owner
  dataFrom:
    - extract:
        key: "{{ backend_secret_name }}"
