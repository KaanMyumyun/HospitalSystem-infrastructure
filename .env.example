# Copy to .env.local and fill in. scripts/tf.sh and the Ansible bootstrap
# source .env.local; it is ignored by git.

# Cloudflare token with Zone:Read and DNS:Edit on hospitalsyst.cc
CLOUDFLARE_API_TOKEN=
# Optional: skips the zone lookup by name
CLOUDFLARE_ZONE_ID=

# Master password of the RDS database. Terraform sets it without storing it,
# and the bootstrap builds the backend's connection string with it. 8 to 128
# characters, none of / ' " @ or a space. To make one:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
HOSPITALSYSTEM_DB_PASSWORD=
# The backend's JWT signing key. Don't type one: python3 scripts/rotate-jwt-key.py
# generates the key here, and later rotates it.
HOSPITALSYSTEM_JWT_SECRET=

# Receives the CloudWatch alarm emails (SNS). AWS sends a confirmation link
# after each apply that creates the topic; nothing arrives until it's clicked.
ALERT_EMAIL=
